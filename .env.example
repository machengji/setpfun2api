# StepFun 免账号模式（二选一即可）
STEPFUN_ANONYMOUS_MODE=1
# STEPFUN_FREE_MODE=1

# 匿名身份 TTL，单位毫秒，默认 30 分钟
# STEPFUN_ANONYMOUS_IDENTITY_TTL_MS=1800000

# 每个匿名身份最多使用的对话轮数，默认 3
# STEPFUN_ANONYMOUS_ROTATE_AFTER=3

# 预热匿名账号池的大小，默认 8
# STEPFUN_ANONYMOUS_POOL_SIZE=8

# 触发上下文文件化压缩的最小字符数（默认 120000，即约 120k 字符）
STEPFUN_CURRENT_INPUT_FILE_MIN_CHARS=120000

# 单次流式响应的超时阈值（单位毫秒，默认 120 秒，防止长上下文计算误判）
# STEPFUN_STREAM_TIMEOUT_MS=120000
