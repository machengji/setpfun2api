{
  "name": "step-free-api",
  "version": "0.0.20",
  "description": "Stepchat Free API Server",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "directories": {
    "dist": "dist"
  },
  "files": [
    "dist/"
  ],
  "bin": "dist/index.cjs",
  "scripts": {
    "dev": "tsup --watch --onSuccess \"node --enable-source-maps dist/index.cjs\"",
    "dev:browser": "set STEPFUN_BROWSER_MODE=1&& tsup --watch --onSuccess \"node --enable-source-maps dist/index.cjs\"",
    "dev:anon": "set STEPFUN_ANONYMOUS_MODE=1&& tsup --watch --onSuccess \"node --enable-source-maps dist/index.cjs\"",
    "start:anon": "set STEPFUN_ANONYMOUS_MODE=1&& node --enable-source-maps dist/index.cjs",
    "start": "node --enable-source-maps dist/index.cjs",
    "build": "tsup",
    "package": "npm run build && pkg ."
  },
  "pkg": {
    "assets": [
      "public/**/*"
    ],
    "targets": [
      "node18-win-x64"
    ],
    "outputPath": "dist"
  },
  "author": "Vinlic",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.6.7",
    "colors": "^1.4.0",
    "crc-32": "^1.2.2",
    "cron": "^3.1.6",
    "date-fns": "^3.3.1",
    "form-data": "^4.0.5",
    "fs-extra": "^11.2.0",
    "koa": "^2.15.0",
    "koa-body": "^5.0.0",
    "koa-bodyparser": "^4.4.1",
    "koa-range": "^0.3.0",
    "koa-router": "^12.0.1",
    "koa2-cors": "^2.0.6",
    "lodash": "^4.17.21",
    "mime": "^3.0.0",
    "minimist": "^1.2.8",
    "playwright": "^1.52.0",
    "randomstring": "^1.3.0",
    "uuid": "^9.0.1",
    "yaml": "^2.3.4"
  },
  "devDependencies": {
    "@types/lodash": "^4.14.202",
    "@types/mime": "^3.0.4",
    "pkg": "^5.8.1",
    "tsup": "^8.0.2",
    "typescript": "^5.3.3"
  }
}
